{
  "name": "discord-reminder-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One YouTube channel, one Discord webhook, scheduled on Cloudflare Workers.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.example.jsonc",
    "test": "npm run build && node --test",
    "check": "npm test",
    "dev": "wrangler dev --test-scheduled --config wrangler.example.jsonc",
    "deploy": "wrangler deploy --config wrangler.private.jsonc"
  },
  "devDependencies": {
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  }
}
