{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-discord-example",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SHORTS_URL": "https://www.youtube.com/@Qlob/shorts",
    "POSTS_URL": "https://www.youtube.com/@Qlob/posts",
    "TIMEZONE": "Europe/London",
    "LOCAL_TIMES": "09:00,17:00",
    "WINDOW_MINUTES": "30"
  },
  "durable_objects": {
    "bindings": [{ "name": "REMINDER", "class_name": "Reminder" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reminder"] }],
  "observability": { "enabled": true }
}
